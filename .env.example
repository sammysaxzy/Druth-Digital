PORT=3000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173,http://localhost:3000
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM=Druth Digital <your-email@gmail.com>
LEAD_NOTIFICATION_EMAIL=druthdigital@gmail.com
MONGODB_URI=mongodb://127.0.0.1:27017/druth-digital
MONGODB_TIMEOUT_MS=10000
RATE_LIMIT_MAX=40
SMTP_CONNECTION_TIMEOUT=10000
SMTP_GREETING_TIMEOUT=10000
SMTP_SOCKET_TIMEOUT=15000
